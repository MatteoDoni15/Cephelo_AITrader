# Credenziali RapidX / Liquidity Arena (ti vengono distribuite dagli organizzatori)
LTP_ACCESS_KEY=
LTP_SECRET_KEY=
LTP_API_HOST=https://api.ltp-contest.com

# AI API dell'organizzatore (dettagli distribuiti entro il 18 luglio insieme agli AI token)
# Compila quando ricevi endpoint/chiave. Vietato usare API AI di terze parti.
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=

# Shared secret tra Advisor <-> Strategy Agent <-> Signal Agent (A2A, solo
# localhost, vedi aitrade/agents/). Genera un valore casuale una sola volta
# (es. `python -c "import secrets;print(secrets.token_hex(16))"`) e usa lo
# STESSO valore per avviare bot + agenti sulla stessa macchina. Vuoto = nessuna
# verifica tra i 3 processi (comportamento di default, retrocompatibile).
AGENTS_SHARED_SECRET=
